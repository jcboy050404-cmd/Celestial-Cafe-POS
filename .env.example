# Google OAuth 2.0 Desktop Client Credentials (Windows)
# Option 1 (Recommended): Create an OAuth Client ID in Google Cloud Console with Application Type: "Desktop app"
GOOGLE_OAUTH_CLIENT_ID_WINDOWS=
GOOGLE_OAUTH_CLIENT_SECRET_WINDOWS=

# Option 2: Optional override for the Windows redirect URI:
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8585

# Google Sign-In Web Client ID (Android & Web)
# From Firebase Console > Authentication > Sign-in method > Google > Web SDK configuration
# Format: 223139901314-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=
